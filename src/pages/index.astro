---
import Layout from '../layouts/Layout.astro';
import MetricsChart from '../components/MetricsChart.astro';
import metrics from '../data/metrics.json';
import { Image } from 'astro:assets';
import portrait from '../assets/victor-portrait.png';
import ProjectGraphic from '../components/ProjectGraphic.astro';
import { projects } from '../data/projects';
import RobotScene from '../components/RobotScene.astro';
import ResearchGraphic from '../components/ResearchGraphic.astro';
import { profile, research, publications } from '../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout>
  <main id="main">
    <section class="hero wrap" id="top">
      <div class="hero-copy">
        <div class="eyebrow hero-intro"><span class="little-cross">+</span> ROBOTICS · ROBOT LEARNING</div>
        <h1>Victor Melbye<br /><span>Staven.</span></h1>
        <div class="hero-sticker">ROBOTICS RESEARCHER</div>
        <div class="hero-profile"><a href="#about" aria-label="About Victor"><Image src={portrait} width={144} height={144} alt="Illustrated portrait of Victor Melbye Staven" class="hero-portrait" format="webp" /></a><div><p class="hero-role">{profile.role}</p><p class="affiliation">{profile.affiliation}</p></div></div>
        <p class="hero-description">Research in dexterous manipulation, tactile sensing, and robot learning.</p>
        <div class="hero-actions"><a class="button" href="#research">View research <span aria-hidden="true">↘</span></a><a class="text-link" href={`${base}cv/`}>View CV <span aria-hidden="true">↗</span></a></div>
        <a class="hero-footnote" href="#research"><span class="scroll-cue" aria-hidden="true">↓</span> Research overview</a>
      </div>
      <RobotScene />
    </section>
    <div class="interest-strip wrap"><span class="eyebrow">RESEARCH INTERESTS</span><div><span>Deformable manipulation</span><i>↗</i><span>Robot learning</span><i>↗</i><span>Dexterous interaction</span></div></div>
    <section class="section wrap" id="research">
      <div class="section-heading"><div><div class="eyebrow section-number">01 — RESEARCH</div><h2>Research areas</h2></div><p>Manipulation, tactile sensing,<br />and simulation-based learning.</p></div>
      <div class="research-grid">{research.map(item => <a class="research-card" href={`${base}research/${item.slug}/`}>
        <ResearchGraphic type={item.graphic} />
        <div class="card-copy"><div class="card-kicker"><span>{item.number} / {item.kind}</span><span class="card-arrow" aria-hidden="true">↗</span></div><h3>{item.title}</h3><p>{item.description}</p><div class="tags">{item.tags.map(tag => <span>{tag}</span>)}</div></div>
      </a>)}</div>
    </section>
    <section class="section publications wrap" id="publications">
      <div class="section-heading"><div><div class="eyebrow section-number">02 — PUBLICATIONS</div><h2>Published work</h2></div>{profile.scholar && <a class="text-link" href={profile.scholar}>Google Scholar ↗</a>}</div>
      <MetricsChart id="citation-chart" title="Citations by paper" unit="citations" total={metrics.citations.total} summary="profile citations" updated={metrics.updated} source={metrics.citations.source} sourceLabel="Google Scholar" rows={metrics.citations.rows} note="Citation counts per paper at the date shown." />
      {publications.length ? <div class="publication-list">{publications.map(p => <article class="publication"><span class="eyebrow">{p.year}</span><div><h3>{p.title}</h3><p>{p.authors}</p><p>{p.venue}</p><div class="publication-links">{p.paper && <a href={p.paper}>Paper ↗</a>}{p.code && <a href={p.code}>Code ↗</a>}{p.video && <a href={p.video}>Video ↗</a>}{p.bibtex && <details><summary>BibTeX</summary><pre>{p.bibtex}</pre></details>}</div></div></article>)}</div> : <div class="publication-empty"><span class="paper-icon" aria-hidden="true">≡</span><div><h3>Publications</h3><p>Publications and accompanying research materials will appear here.</p></div><span class="empty-label">TO BE ADDED</span></div>}
    </section>
    <section class="section projects wrap" id="projects">
      <div class="section-heading"><div><div class="eyebrow section-number">03 — SELECTED PROJECTS</div><h2>Software and models</h2></div><a class="text-link" href={`${profile.github}?tab=repositories`}>More on GitHub <span aria-hidden="true">↗</span></a></div>
      <div class="project-grid">{projects.map(project => <article class="project-card">
        <a class="project-preview-link" href={project.href} aria-label={`Explore ${project.title}`}><ProjectGraphic type={project.id} /></a>
        <div class="project-copy"><div class="eyebrow project-category">{project.category}</div><h3><a href={project.href}>{project.title}</a></h3><p>{project.description}</p><p class="project-credit">{project.detail}</p><div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div><a class="project-link" href={project.href}>{project.linkLabel} <span aria-hidden="true">↗</span></a></div>
      </article>)}</div>
      <MetricsChart id="star-chart" title="Stars across selected projects" unit="stars" total={metrics.stars.total} summary="featured-project stars" updated={metrics.updated} source={metrics.stars.source} sourceLabel="GitHub" rows={metrics.stars.rows} note="Stars for the featured repositories at the date shown. Hand-E refers to my fork of MuJoCo Menagerie." />
    </section>
    <section class="section about wrap" id="about"><div><div class="eyebrow section-number">04 — ABOUT</div><h2>About</h2><figure class="portrait-frame"><Image src={portrait} width={640} height={640} alt="Illustrated portrait of Victor Melbye Staven" loading="lazy" format="webp" /><figcaption>Victor Melbye Staven</figcaption></figure><a class="text-link" href={`${base}cv/`}>View CV <span aria-hidden="true">↗</span></a></div><div class="about-copy"><p>{profile.bio}</p><div class="social-links"><a href={profile.institutional}>SDU profile ↗</a><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>{profile.email && <a href={`mailto:${profile.email}`}>Email ↗</a>}{profile.linkedin && <a href={profile.linkedin}>LinkedIn ↗</a>}</div></div></section>
    <section class="contact-invitation wrap" id="contact" aria-labelledby="contact-title">
      <div><div class="eyebrow">CONTACT</div><h2 id="contact-title">Research enquiries</h2><p>For questions about my research, software, or potential collaborations, please contact me by email.</p></div>
      <div class="contact-actions"><a class="button" href={`mailto:${profile.email}`}>Send email <span aria-hidden="true">↗</span></a><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a></div>
    </section>
  </main>
</Layout>
