---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/victor-portrait.png';
import ProjectGraphic from '../components/ProjectGraphic.astro';
import { projects } from '../data/projects';
import RobotScene from '../components/RobotScene.astro';
import ResearchGraphic from '../components/ResearchGraphic.astro';
import { profile, research, publications } from '../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout>
  <main id="main">
    <section class="hero wrap" id="top">
      <div class="hero-copy">
        <div class="eyebrow"><span class="little-cross">+</span> ROBOTICS · LEARNING · MANIPULATION</div>
        <h1>Victor Melbye<br /><span>Staven.</span></h1>
        <div class="hero-profile"><a href="#about" aria-label="About Victor"><Image src={portrait} width={144} height={144} alt="Illustrated portrait of Victor Melbye Staven" class="hero-portrait" format="webp" /></a><div><p class="hero-role">{profile.role}</p><p class="affiliation">{profile.affiliation}</p></div></div>
        <p class="hero-description">Teaching robots to make sense<br class="desktop-break" /> of a world that doesn’t sit still.</p>
        <div class="hero-actions"><a class="button" href="#research">Explore my research <span aria-hidden="true">↘</span></a><a class="text-link" href={`${base}cv/`}>View CV <span aria-hidden="true">↗</span></a></div>
        <div class="hero-footnote"><span class="small-line"></span> Learning through interaction with the physical world.</div>
      </div>
      <RobotScene />
    </section>
    <div class="interest-strip wrap"><span class="eyebrow">RESEARCH INTERESTS</span><div><span>Deformable manipulation</span><i>↗</i><span>Robot learning</span><i>↗</i><span>Dexterous interaction</span></div></div>
    <section class="section wrap" id="research">
      <div class="section-heading"><div><div class="eyebrow section-number">01 — RESEARCH</div><h2>Working with the physical world.</h2></div><p>Flexible objects. Complex contact.<br />Learning to handle both.</p></div>
      <div class="research-grid">{research.map(item => <a class="research-card" href={`${base}research/${item.slug}/`}>
        <ResearchGraphic type={item.graphic} />
        <div class="card-copy"><div class="card-kicker"><span>{item.number} / {item.kind}</span><span class="card-arrow" aria-hidden="true">↗</span></div><h3>{item.title}</h3><p>{item.description}</p><div class="tags">{item.tags.map(tag => <span>{tag}</span>)}</div></div>
      </a>)}</div>
    </section>
    <section class="section publications wrap" id="publications">
      <div class="section-heading"><div><div class="eyebrow section-number">02 — PUBLICATIONS</div><h2>Research, in writing.</h2></div>{profile.scholar && <a class="text-link" href={profile.scholar}>Google Scholar ↗</a>}</div>
      {publications.length ? <div class="publication-list">{publications.map(p => <article class="publication"><span class="eyebrow">{p.year}</span><div><h3>{p.title}</h3><p>{p.authors}</p><p>{p.venue}</p><div class="publication-links">{p.paper && <a href={p.paper}>Paper ↗</a>}{p.code && <a href={p.code}>Code ↗</a>}{p.video && <a href={p.video}>Video ↗</a>}{p.bibtex && <details><summary>BibTeX</summary><pre>{p.bibtex}</pre></details>}</div></div></article>)}</div> : <div class="publication-empty"><span class="paper-icon" aria-hidden="true">≡</span><div><h3>A space for papers and ideas.</h3><p>Publications and accompanying research materials will appear here.</p></div><span class="empty-label">TO BE ADDED</span></div>}
    </section>
    <section class="section projects wrap" id="projects">
      <div class="section-heading"><div><div class="eyebrow section-number">03 — SELECTED PROJECTS</div><h2>Tools built along the way.</h2></div><a class="text-link" href={`${profile.github}?tab=repositories`}>More on GitHub <span aria-hidden="true">↗</span></a></div>
      <div class="project-grid">{projects.map(project => <article class="project-card">
        <ProjectGraphic type={project.id} />
        <div class="project-copy"><div class="eyebrow project-category">{project.category}</div><h3><a href={project.href}>{project.title}</a></h3><p>{project.description}</p><p class="project-credit">{project.detail}</p><div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div><a class="project-link" href={project.href}>{project.linkLabel} <span aria-hidden="true">↗</span></a></div>
      </article>)}</div>
    </section>
    <section class="section about wrap" id="about"><div><div class="eyebrow section-number">04 — ABOUT</div><h2>Curiosity, grounded<br />in the real world.</h2><figure class="portrait-frame"><Image src={portrait} width={640} height={640} alt="Hand-painted cartoon portrait of Victor, smiling with glasses" loading="lazy" format="webp" /><figcaption>A little more illustrated. Still me.</figcaption></figure><a class="text-link" href={`${base}cv/`}>More about my background <span aria-hidden="true">↗</span></a></div><div class="about-copy"><p>{profile.bio}</p><p>This space brings together my research interests, projects, and interactive explorations of robotics.</p><div class="social-links"><a href={profile.institutional}>SDU profile ↗</a><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>{profile.email && <a href={`mailto:${profile.email}`}>Email ↗</a>}{profile.linkedin && <a href={profile.linkedin}>LinkedIn ↗</a>}</div></div></section>
  </main>
</Layout>
