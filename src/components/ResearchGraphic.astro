---
import { Image } from 'astro:assets';
import CableRoutingDiagram from './CableRoutingDiagram.astro';
import hand from '../assets/research/hand-carbon.png';
import simulation from '../assets/research/simulation.png';
interface Props { type: string; large?: boolean; }
const { type, large = false } = Astro.props;
const visuals = {
  hand: { image: hand, label: 'Shadow Hand E3M5', caption: 'Model visualization', alt: 'Detailed render of the articulated Shadow Hand model holding a cylindrical object between its thumb and index finger.' },
  simulation: { image: simulation, label: 'Geometry and articulation', caption: 'Model visualization', alt: 'Solid and wireframe views of the same articulated Shadow Hand model on a simulation grid.' },
};
const visual = visuals[type as keyof typeof visuals] || visuals.simulation;
---
<figure class={`research-graphic ${type}`}>
  {type === 'cable' ? <CableRoutingDiagram /> : <Image src={visual.image} alt={visual.alt} widths={[440, 720, 1100, 1500]} sizes={large ? '(max-width: 760px) 100vw, 50vw' : '(max-width: 760px) 100vw, 33vw'} width={1500} height={960} format="webp" quality={85} loading="lazy" decoding="async" />}
  <figcaption><span>{type === 'cable' ? 'Cable manipulation' : visual.label}</span><span>{type === 'cable' ? 'Tactile following · schematic' : visual.caption}</span></figcaption>
</figure>
<style>
  .research-graphic{margin:0;position:relative;overflow:hidden;background:var(--raised);border:0;color:var(--ink)}
  .research-graphic img{display:block;width:100%;height:auto;aspect-ratio:25/16;object-fit:cover;transition:transform .4s ease}
  figcaption{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 17px;background:var(--raised);border-top:1px solid var(--line);font-size:9px;line-height:1.5;letter-spacing:.2px}
  figcaption>span:last-child{color:var(--muted);font-size:8px;text-align:right}
  .simulation figcaption{background:var(--raised);color:var(--ink);border-color:var(--line)}.simulation figcaption>span:last-child{color:var(--muted)}
  :global(.research-card:hover) img,:global(.research-card:focus-within) img{transform:scale(1.025)}
  @media(prefers-reduced-motion:reduce){.research-graphic img{transition:none;transform:none!important}}
</style>
