      <rect x="264" y="95" width="32" height="40" rx="5" fill="#ff8045"/><path d="m169 107-21 0m243 0h21" stroke="#ff8045" stroke-width="3"/><path d="m158 100 12 7-12 7m244-14-12 7 12 7" stroke="#ff8045" stroke-width="3"/>
    </> : <>
      <ellipse cx="279" cy="263" rx="161" ry="23" fill="#111214" opacity=".13"/>
      <g transform="rotate(-10 213 155)"><rect x="123" y="40" width="160" height="215" rx="3" fill="#aaaeb6" stroke="#777f89"/><path d="M144 67h107m-107 13h83M144 104h113m-113 10h113m-113 10h97M144 153h113m-113 10h113m-113 10h103M144 223h87" stroke="#636b76" stroke-width="3"/></g>
      <g transform="rotate(7 324 160)"><rect x="230" y="28" width="171" height="236" rx="3" fill="#dfe2e7" stroke="#777f89"/><rect x="250" y="53" width="9" height="29" fill="#303740"/><path d="M269 59h100m-100 11h76" stroke="#303740" stroke-width="4"/><path d="M250 103h130m-130 10h130m-130 10h98" stroke="#9aa3af" stroke-width="3"/>
      <path d="M255 205v-62m0 62h118" stroke="#757e8b" stroke-width="1.5"/><path d="m261 191 22-13 22 6 26-31 34-9" stroke="#e95e22" stroke-width="3"/>
      <path d="M250 232h87" stroke="#9aa3af" stroke-width="3"/><text x="367" y="247" fill="#68717e" font-size="8" font-family="sans-serif">01</text></g>
      <path d="m423 92-22 153" stroke="#383f49" stroke-width="10" stroke-linecap="round"/><path d="m401 245-2 14 9-12" fill="#ff8045"/>
    </>}
  </svg>
  <div class="preview-caption"><span>{labels[type]}</span><span>ILLUSTRATION</span></div>
</div>
<style>
.project-preview{background:#202328;color:#cbd0d5;overflow:hidden;position:relative;aspect-ratio:1.65}
.project-preview.biotac{background:#25282d;color:#cbd0d5}.project-preview.hande{background:#202328;color:#cbd0d5}.project-preview.thesis{background:#25282d;color:#cbd0d5}
.preview-topline,.preview-caption{position:absolute;left:25px;right:25px;display:flex;justify-content:space-between;gap:12px;font-size:9px;letter-spacing:1.2px;z-index:1}
.preview-topline{top:20px}.preview-topline>span:last-child{font-size:22px;line-height:1}.preview-caption{bottom:18px;font-size:8px}.preview-caption>span:last-child{opacity:.65;font-size:7px}
svg{width:100%;height:100%;display:block;padding:26px 10px 22px;transition:transform .5s cubic-bezier(.2,.7,.2,1)}
:global(.project-card:hover) svg,:global(.project-card:focus-within) svg{transform:scale(1.035)}
.gripper-left,.gripper-right{transition:transform .5s ease}:global(.project-card:hover) .gripper-left,:global(.project-card:focus-within) .gripper-left{transform:translateX(9px)}:global(.project-card:hover) .gripper-right,:global(.project-card:focus-within) .gripper-right{transform:translateX(-9px)}
@media(max-width:760px){.preview-topline,.preview-caption{left:18px;right:18px;font-size:8px}.preview-caption>span:last-child{display:none}}
@media(prefers-reduced-motion:reduce){svg,.gripper-left,.gripper-right{transition:none!important;transform:none!important}}
</style>
