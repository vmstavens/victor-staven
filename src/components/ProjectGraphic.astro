      <ellipse cx="262" cy="267" rx="106" ry="19" fill="#111214" opacity=".16"/>
      <path d="M203 245V110a58 58 0 0 1 116 0v135z" fill="#b7bcc3" stroke="#777f89" stroke-width="2"/>
      <path d="M216 240V111a45 45 0 0 1 90 0v129" stroke="#e3e5e8" stroke-width="3"/>
      <ellipse cx="261" cy="146" rx="51" ry="67" fill="#ff9d70" opacity=".35"/>
      <ellipse cx="261" cy="138" rx="37" ry="47" fill="#ff8147" opacity=".5"/>
      <ellipse cx="261" cy="130" rx="23" ry="28" fill="#ff6b2b" opacity=".65"/>
      <ellipse cx="261" cy="123" rx="10" ry="13" fill="#ffd4b8"/>
      <g fill="#555b65">{Array.from({length: 4}, (_, row) => Array.from({length: 3}, (_, col) => <circle cx={237+col*24} cy={166+row*20} r="3"/>))}</g>
      <rect x="196" y="237" width="131" height="24" rx="7" fill="#606773"/>
      <path d="m319 122 57-37h48M316 207l62 21h46" stroke="#9fa7b2" stroke-width="1.5"/>
      <text x="379" y="75" fill="#c2c8d0" font-size="11" font-family="sans-serif">CONTACT</text><text x="379" y="248" fill="#c2c8d0" font-size="11" font-family="sans-serif">SENSING</text>
    </> : type === 'hande' ? <>
      <g stroke="#87929d" opacity=".25"><path d="m72 244 205-104 210 103M112 265l204-104M152 285l204-104M112 224l204 103M152 204l204 103"/></g>
      <ellipse cx="280" cy="266" rx="113" ry="21" fill="#111214" opacity=".2"/>
      <g class="gripper-left"><path d="M213 197V70h32v92" stroke="#656d78" stroke-width="25" stroke-linejoin="round"/><path d="M213 196V70h32v92" stroke="#d7dbe0" stroke-width="16" stroke-linejoin="round"/><rect x="241" y="77" width="12" height="58" rx="3" fill="#373c45"/></g>
      <g class="gripper-right"><path d="M347 197V70h-32v92" stroke="#656d78" stroke-width="25" stroke-linejoin="round"/><path d="M347 196V70h-32v92" stroke="#d7dbe0" stroke-width="16" stroke-linejoin="round"/><rect x="307" y="77" width="12" height="58" rx="3" fill="#373c45"/></g>
      <rect x="192" y="174" width="176" height="78" rx="13" fill="#555e6a"/><rect x="192" y="174" width="176" height="13" rx="5" fill="#9ba6b4"/>
