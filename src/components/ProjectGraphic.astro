---
interface Props { type: string; }
const { type } = Astro.props;
const labels: Record<string, string> = { mjsim: 'MUJOCO SIMULATION UTILITIES', biotac: 'TACTILE SENSOR SIMULATION', hande: 'ROBOTIQ HAND-E MODEL', thesis: 'LATEX TEMPLATE AND UTILITIES' };
---
<div class={`project-preview ${type}`} aria-hidden="true">
  <div class="preview-topline"><span>{type === 'mjsim' ? '01 / SIMULATION' : type === 'biotac' ? '02 / TACTILE SENSING' : type === 'hande' ? '03 / ROBOT MODEL' : '04 / RESEARCH TOOLS'}</span><span>↗</span></div>
