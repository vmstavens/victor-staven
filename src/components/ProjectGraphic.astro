    {type === 'mjsim' ? <>
      <ellipse cx="292" cy="249" rx="186" ry="26" fill="#101214" opacity=".35"/>
      <g stroke="#68717c" stroke-width="1" opacity=".45"><path d="m51 211 223-112 235 113-224 112zM92 191l234 111M135 170l234 111M179 148l234 111M222 127l234 111M93 232l225-112M140 254l224-112M187 277l224-112M233 299l224-112"/></g>
      <path d="m170 219 77-37 72 36-78 38z" fill="#979fa8"/><path d="m170 219 71 37 78-38v14l-78 37-71-36z" fill="#454b54"/>
      <g stroke-linecap="round" stroke-linejoin="round"><path d="M236 217v-73l-47-44 77-57 76 67" stroke="#25292f" stroke-width="40"/><path d="M236 214v-70l-47-44 77-57 76 67" stroke="#d1d5da" stroke-width="27"/>
      <g fill="#444a53" stroke="#9da5af" stroke-width="4"><circle cx="236" cy="144" r="19"/><circle cx="189" cy="100" r="19"/><circle cx="266" cy="43" r="19"/></g>
      <path d="m342 110 22 13-9 22m-13-35-14 25 16 17" stroke="#d2d6db" stroke-width="9"/></g>
      <path d="m354 204 37-19 34 18-37 20z" fill="#ff9561"/><path d="m354 204 34 19v39l-34-20z" fill="#b74c20"/><path d="m388 223 37-20v38l-37 21z" fill="#f26b2d"/>
      <path d="M358 174c62-27 78-58 47-86" stroke="#ff8045" stroke-width="2" stroke-dasharray="5 7"/>
      <circle cx="405" cy="88" r="5" fill="#ff8045"/>
    </> : type === 'biotac' ? <>
