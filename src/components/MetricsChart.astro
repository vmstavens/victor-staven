---
interface Props {
  id: string;
  title: string;
  unit: string;
  total: number;
  summary: string;
  updated: string;
  source: string;
  sourceLabel: string;
  note: string;
  rows: { label: string; title?: string; value: number; href: string }[];
}
const { id, title, unit, total, summary, updated, source, sourceLabel, note, rows } = Astro.props;
const maximum = Math.max(1, ...rows.map(row => row.value));
const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${updated}T00:00:00Z`));
---
<figure class="metrics-chart" aria-labelledby={`${id}-title`}>
  <figcaption>
    <div><div class="eyebrow">{sourceLabel}</div><h3 id={`${id}-title`}>{title}</h3></div>
    <p class="metrics-total"><strong>{total}</strong><span>{summary}</span></p>
  </figcaption>
  <dl class="metrics-bars">
    {rows.map(row => <div class="metrics-row">
      <dt><a href={row.href} title={row.title || row.label}>{row.label}<span aria-hidden="true"> ↗</span></a></dt>
      <dd><span class="metrics-track" aria-hidden="true"><span class="metrics-fill" style={`width:${100 * row.value / maximum}%`}></span></span><span class="metrics-value">{row.value}<span class="metrics-sr-only"> {unit}</span></span></dd>
    </div>)}
  </dl>
  <div class="metrics-footer"><p>{note}</p><p><a href={source}>Source: {sourceLabel} ↗</a><span>Updated <time datetime={updated}>{date}</time></span></p></div>
</figure>
<style>
  .metrics-chart{margin:0 0 32px;padding:26px 30px;background:var(--surface);border:1px solid var(--line);border-radius:2px}
  figcaption{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px}
  h3{font-size:20px;font-weight:550;letter-spacing:-.5px;margin-top:4px}
  .metrics-total{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:11px;line-height:1.5}
  .metrics-total strong{color:var(--ink);font-family:'Manrope',sans-serif;font-size:36px;font-weight:500;font-variant-numeric:tabular-nums}
  .metrics-total>span{max-width:110px}
  .metrics-bars{margin:0;display:grid;gap:17px}
  .metrics-row{display:grid;grid-template-columns:180px minmax(0,1fr);gap:24px;align-items:center}
  dt{font-size:12px;line-height:1.5}dt a:hover,.metrics-footer a:hover{color:var(--blue);text-decoration:underline}
  dd{margin:0;display:flex;align-items:center;gap:16px}
  .metrics-track{height:12px;background:var(--line);flex:1;border-radius:2px;overflow:hidden}
  .metrics-fill{display:block;height:100%;background:var(--flame);border-radius:2px}
  .metrics-value{min-width:2ch;text-align:right;font-size:14px;font-weight:600;font-variant-numeric:tabular-nums}
  .metrics-footer{border-top:1px solid var(--line);margin-top:23px;padding-top:14px;color:var(--muted);font-size:10px;line-height:1.7;display:flex;justify-content:space-between;gap:24px}
  .metrics-footer>p:first-child{max-width:440px}.metrics-footer>p:last-child{text-align:right;flex-shrink:0}.metrics-footer span{display:block}
  .metrics-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:760px){.metrics-chart{padding:22px 18px}.metrics-row{grid-template-columns:1fr;gap:6px}.metrics-bars{gap:18px}h3{font-size:18px}.metrics-total{gap:8px}.metrics-total strong{font-size:30px}.metrics-total>span{max-width:70px;font-size:10px}.metrics-footer{display:block}.metrics-footer>p:last-child{text-align:left;margin-top:10px}.metrics-footer span{display:inline;margin-left:12px}}
</style>
